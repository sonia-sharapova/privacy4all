{
  "subtitle": "Recommended browsers, compared — desktop and phone.",
  "subsections": [
    {
      "id": "recommended",
      "title": "Recommended Browsers",
      "blocks": [
        {
          "type": "text",
          "html": "<p>Judged on usability, privacy, customizability, philosophy, respect for the user, looks, and resource usage.</p>"
        },
        {
          "type": "redirects",
          "style": "cards",
          "cols": 4,
          "items": [
            {
              "label": "Brave",
              "url": "https://brave.com/download/",
              "icon": "assets/icon-brave.jpg",
              "meta": "Desktop, Android, iOS · Chromium-based",
              "desc": "Blocks ads, trackers and fingerprinting the moment you install it, no setup needed. It runs Chrome extensions, which makes it the easiest switch if you're coming from Chrome. You can switch off the extras you don't need (crypto wallet, Rewards, the Leo AI assistant) in settings.",
              "linkText": "Download"
            },
            {
              "label": "DuckDuckGo",
              "url": "https://duckduckgo.com/app",
              "icon": "assets/icon-duckduckgo.png",
              "meta": "Desktop, Android, iOS",
              "desc": "Blocks trackers and tells sites not to sell your data (Global Privacy Control) by default. The Fire button wipes your tabs and browsing data in one tap. The simplest option here, but it has no extensions on desktop and only limited ad blocking. Its AI features can be turned off in settings.",
              "linkText": "Download"
            },
            {
              "label": "Mullvad Browser",
              "url": "https://mullvad.net/browser",
              "icon": "assets/icon-mullvad.png",
              "meta": "Desktop · Firefox-based",
              "desc": "Built with the Tor Project. It has Tor Browser's anti-fingerprinting, so every user looks the same to websites, but it skips the slow Tor network. Ads and trackers are blocked by default. It doesn't hide your IP on its own, so pair it with a VPN.",
              "linkText": "Download"
            },
            {
              "label": "Safari",
              "url": "https://support.apple.com/safari",
              "icon": "assets/icon-safari.jpeg",
              "meta": "iOS, macOS",
              "desc": "Apple's built-in browser. It limits cross-site tracking and fingerprinting automatically. On iPhone every browser uses Safari's engine anyway, which is why Privacy Guides recommends it for iOS. Add uBlock Origin Lite (available since 2025) to block ads.",
              "linkText": "Learn more"
            },
            {
              "label": "Firefox",
              "url": "https://www.mozilla.org/firefox/new/",
              "icon": "assets/icon-firefox.webp",
              "meta": "Desktop",
              "desc": "The main independent alternative to Chrome, with the widest range of privacy extensions. Out of the box, though, it sends usage data to Mozilla and has AI features switched on. Change a few settings to make it private; our hardening guide walks you through it. <a href=\"page:browser-fingerprinting#protection\">Hardening guide →</a>",
              "linkText": "Download"
            },
            {
              "label": "LibreWolf",
              "url": "https://librewolf.net/",
              "icon": "assets/icon-librewolf.svg",
              "meta": "Desktop · Firefox-based",
              "desc": "Firefox with the privacy work already done: Mozilla's telemetry removed, strict tracking protection on, and uBlock Origin pre-installed. You keep Firefox's flexibility and extensions without configuring anything yourself.",
              "linkText": "Download"
            },
            {
              "label": "Tor Browser",
              "url": "https://www.torproject.org/download/",
              "icon": "assets/tor.svg",
              "meta": "Desktop, Android",
              "desc": "Routes your traffic through three volunteer-run relays, so the sites you visit never see your real IP or location. It offers the strongest anonymity available, but pages load slower and some sites block it. Use it when anonymity matters, not for everyday browsing.",
              "linkText": "Download"
            }
          ],
          "card": true
        }
      ],
      "summary": "Comparing browsers."
    },
